<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/pagerFragment">

    <fragment
        android:id="@+id/secondPagerFragment"
        android:name="com.example.pager.ui.SecondPagerFragment"
        android:label="SecondPagerFragment"
        tools:layout="@layout/fragment_second_pager">

        <action
            android:id="@+id/action_secondPagerFragment_to_CreateNotes"
            app:destination="@id/CreateNotes" >
            <argument
                android:name="task"
                app:argType="com.example.pager.models.NotesModel"
                app:nullable="true"
                />
        </action>

    </fragment>


    <fragment
        android:id="@+id/pagerFragment"
        android:name="com.example.pager.ui.PagerFragment"
        android:label="fragment_pager"
        tools:layout="@layout/fragment_pager">

    </fragment>
    <fragment
        android:id="@+id/CreateNotes"
        android:name="com.example.pager.ui.CreateNotes"
        android:label="fragment_create_notes"
        tools:layout="@layout/fragment_create_notes" >
        <argument
            android:name="task"
            app:argType="com.example.pager.models.NotesModel"
            app:nullable="true"
            />

    </fragment>

</navigation>