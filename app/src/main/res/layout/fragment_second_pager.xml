<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conteiner1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    android:focusable="false"
    android:animateLayoutChanges="true"
    android:focusableInTouchMode="false">

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_mainTitle"
        app:layout_constraintStart_toStartOf="@id/et_search"
        app:layout_constraintTop_toTopOf="@id/tv_mainTitle" />

    <TextView
        android:id="@+id/tv_mainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notesAll"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginTop="14dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_changeType"
        android:layout_width="30dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_shape"
        app:layout_constraintBottom_toBottomOf="@id/tv_mainTitle"
        app:layout_constraintEnd_toEndOf="@id/et_search"
        app:layout_constraintTop_toTopOf="@id/tv_mainTitle" />


    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/corner_12"
        android:backgroundTint="@color/gray"
        android:paddingStart="20dp"
        android:hint="@string/search"
        android:textColorHint="@color/gray_light"
        android:drawableStart="@drawable/ic_lupa"
        android:drawablePadding="20dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_mainTitle" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notes_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/et_search"
        tools:listitem="@layout/notes_item" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="30dp"
        android:backgroundTint="@color/dark_yellow"
        android:text="+"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_delete_change"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black_50">

        <View
            android:id="@+id/view_delete_change"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/gray"
            android:background="@drawable/corner_10"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            app:layout_constraintStart_toStartOf="@id/view_delete_change"
            app:layout_constraintEnd_toEndOf="@id/view_delete_change"
            android:text="Удалить заметку?"
            android:textSize="20sp"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="@id/view_delete_change"
            android:layout_marginBottom="80dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dont"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Отмена"
            android:textSize="22sp"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            app:layout_constraintStart_toStartOf="@id/view_delete_change"
            app:backgroundTint="@color/gray"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            android:layout_margin="20dp"
            app:strokeColor="@color/gray_light"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_change"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/view_delete_change"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            android:text="Удалить"
            android:textSize="22sp"
            android:padding="10dp"
            app:backgroundTint="@color/dark_yellow"
            app:cornerRadius="12dp"
            android:layout_margin="20dp"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>