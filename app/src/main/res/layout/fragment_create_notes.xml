<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    android:paddingTop="30dp"
    tools:context=".ui.create.CreateNotes">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:background="@drawable/corner_10"
        android:backgroundTint="@color/gray"
        android:hint="Select Date"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintEnd_toStartOf="@id/iv_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_create_title"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_margin="10dp"
        android:background="@drawable/corner_10"
        android:maxLines="1"
        android:hint="title"
        android:textSize="40sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="titlr" />

    <EditText
        android:id="@+id/et_create_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/corner_10"
        android:hint="descriptin"
        android:maxLength="500"
        android:maxLines="40"
        android:textColor="@color/white"
        android:textSize="22sp"
        tools:text="description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_create_title" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="@color/dark_yellow"
        android:text="save"
        android:textSize="30sp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_create_desc" />

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/sharp_ar_stickers_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_menu_change"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:background="@drawable/corner_10"
        android:backgroundTint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_menu">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_red"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/light_red"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_yellow"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:backgroundTint="@color/banana"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_red"
            app:layout_constraintStart_toEndOf="@id/btn_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_blue"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:backgroundTint="@color/blue_light"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_yellow"
            app:layout_constraintStart_toEndOf="@id/btn_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salad"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/salad"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toTopOf="@id/btn_red"
            app:layout_constraintStart_toStartOf="@id/btn_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pink"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/pink"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toTopOf="@id/btn_yellow"
            app:layout_constraintStart_toStartOf="@id/btn_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_purple"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/purple"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toTopOf="@id/btn_blue"
            app:layout_constraintStart_toStartOf="@id/btn_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="поменять цвет"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/btn_salad"
            app:layout_constraintStart_toStartOf="@id/btn_red" />

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Удалить"
            android:textColor="@color/red"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/gray_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_delete" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

