<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    android:animateLayoutChanges="true"
    tools:context=".ui.create.CreateNotes">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:backgroundTint="@color/gray"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:textColor="@color/white"
        android:textSize="22sp"
        tools:text="12.20.15"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintEnd_toStartOf="@id/iv_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_create_title"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/corner_12"
        android:maxLines="1"
        android:layout_marginTop="16dp"
        android:textSize="40sp"
        android:backgroundTint="@color/dark_gray"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:hint="Title"
        android:textColorHint="@color/white"/>

    <EditText
        android:id="@+id/et_create_desc"
        android:backgroundTint="@color/dark_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/corner_12"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginTop="12dp"
        android:hint="description"
        android:textColorHint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_create_title" />

    <TextView
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/dark_yellow"
        android:text="Готово"
        android:visibility="gone"
        android:textColor="@color/dark_yellow"
        android:layout_marginEnd="20dp"
        android:textSize="22sp"
        app:layout_constraintTop_toTopOf="@id/tv_date"
        app:layout_constraintBottom_toBottomOf="@id/tv_date"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_menu_create_notes"
        app:layout_constraintEnd_toStartOf="@id/btn_save"
        app:layout_constraintTop_toTopOf="@id/tv_date"
        app:layout_constraintBottom_toBottomOf="@id/tv_date"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/tv_date"
        app:layout_constraintBottom_toBottomOf="@id/tv_date"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_back"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_menu_change"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/corner_12"
        android:backgroundTint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_menu">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_red"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/light_red"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_yellow"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/banana"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_red"
            app:layout_constraintStart_toEndOf="@id/btn_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_blue"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/blue_light"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_yellow"
            app:layout_constraintStart_toEndOf="@id/btn_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salad"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/salad"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toTopOf="@id/btn_red"
            app:layout_constraintStart_toStartOf="@id/btn_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pink"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/pink"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toTopOf="@id/btn_yellow"
            app:layout_constraintStart_toStartOf="@id/btn_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_purple"
            android:layout_width="50dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/purple"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toTopOf="@id/btn_blue"
            app:layout_constraintStart_toStartOf="@id/btn_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="поменять цвет"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_delete"
            app:layout_constraintBottom_toTopOf="@id/btn_salad"
            app:layout_constraintStart_toStartOf="@id/btn_red" />

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="match_parent"
            android:layout_margin="10dp"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="Удалить"
            android:textColor="@color/red"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_bine"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_delete"
            app:layout_constraintTop_toTopOf="@id/tv_delete"
            android:src="@drawable/ic_bine"
            />

        <TextView
            android:id="@+id/tv_stick"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@color/gray_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_delete" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_delete_change"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black_50">

        <View
            android:id="@+id/view_delete_change"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/gray"
            android:background="@drawable/corner_10"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            app:layout_constraintStart_toStartOf="@id/view_delete_change"
            app:layout_constraintEnd_toEndOf="@id/view_delete_change"
            android:text="Удалить заметку?"
            android:textSize="20sp"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="@id/view_delete_change"
            android:layout_marginBottom="80dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dont"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Отмена"
            android:textSize="22sp"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            app:layout_constraintStart_toStartOf="@id/view_delete_change"
            app:backgroundTint="@color/gray"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            android:layout_margin="20dp"
            app:strokeColor="@color/gray_light"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_change"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/view_delete_change"
            app:layout_constraintBottom_toBottomOf="@id/view_delete_change"
            android:text="Удалить"
            android:textSize="22sp"
            android:padding="10dp"
            app:backgroundTint="@color/dark_yellow"
            app:cornerRadius="12dp"
            android:layout_margin="20dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

